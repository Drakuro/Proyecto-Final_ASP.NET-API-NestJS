# =====================================================
# Environment variables — copy this file to .env and adjust
#   cp .env.example .env
# NEVER commit the real .env file (it is gitignored).
# =====================================================

# Prisma 7 + SQLite
# Relative to the project root (game-vault-query-api/).
DATABASE_URL="file:./prisma/dev.db"

# JWT authentication
# Generate your own secret — it must be a random 64-character hex string.
# You can create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or:
#   openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_hex_string
# Token lifetime (https://github.com/vercel/ms). Default: 7 days.
JWT_EXPIRES_IN=7d